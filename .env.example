# このファイルを .env にコピーして値を設定してください: cp .env.example .env

# --- 外部API ---
# Holodex APIキー（https://holodex.net/login で取得）
HOLODEX_API_KEY=your_holodex_api_key
# Discord通知用Webhook URL（未設定の場合は通知をスキップ）
DISCORD_WEBHOOK_URL=your_discord_webhook_url
# Gemini APIキー（未設定の場合はAIおすすめ生成をスキップ）
GEMINI_API_KEY=your_gemini_api_key

# --- 管理APIの認証 ---
# 管理APIの認証キー。長いランダム文字列を推奨（例: openssl rand -hex 32）
# 未設定かつ BYPASS_ADMIN_AUTH が true でない場合、管理APIとcronは 503 になります
ADMIN_SECRET_KEY=your_admin_secret_key

# Cloudflare Access等の前段認証で保護する場合のみ true にする（管理者キー認証を無効化）
# NEXT_PUBLIC_ はビルド時に埋め込まれるため、変更後は docker compose up -d --build が必要
BYPASS_ADMIN_AUTH=false
NEXT_PUBLIC_BYPASS_ADMIN_AUTH=false

# --- ネットワーク ---
# アプリのバインドアドレス。前段プロキシと同一ホストなら 127.0.0.1 で直接アクセスを遮断
APP_BIND=0.0.0.0

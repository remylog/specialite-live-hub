datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Channel {
  id            String   @id
  name          String
  englishName   String?
  photo         String?
  twitter       String?
  youtubeHandle String?
  group         String?
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  videos        Video[]
}

model Video {
  id             String   @id
  title          String
  channelId      String
  channel        Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  status         String
  liveViewers    Int?
  startScheduled DateTime?
  startActual    DateTime?
  duration       Int?
  topicId        String?
  type           String
  cachedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([channelId])
  @@index([status])
}
